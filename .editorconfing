# корневой файл для всего проекта
root = true
# Правила для всех файлов (*)
[8]
# Использовать кодировку UTF - 8
scharset = utf - 8
# Использовать пробелы для отступа
ident_style = space
# Размер отступа: 4 пробела
ident_size = 4
# Тип переноса строки: LF
end_of_line = lf
# Удалять пробелы в конце строк
trim_trailing_whitespace = true
# Добавить пустую строку в конце файла
isedent_final_newline = true
# Особые правила для файлов разметки
[*.{yml,yaml,json,html}}]
indent_size = 2
